generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  compliance_manager
  auditor
  viewer
}

enum Plan {
  starter
  growth
  enterprise
}

enum ControlStatus {
  not_started
  in_progress
  implemented
  verified
}

model Organization {
  id                  String                  @id @default(cuid())
  name                String
  plan                Plan                    @default(starter)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  users               User[]
  frameworkSelections FrameworkSelection[]
  controlStatuses     ControlImplementation[]
  policies            Policy[]
  risks               Risk[]
  evidence            Evidence[]
  vendors             Vendor[]
  auditLogs           AuditLog[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  passwordHash   String?
  name           String?
  role           UserRole
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedFiles  Evidence[]   @relation("EvidenceUploader")
}

model Framework {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  description String?
  controls    Control[]
  selections  FrameworkSelection[]
}

model FrameworkSelection {
  id             String       @id @default(cuid())
  organizationId String
  frameworkId    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework      Framework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([organizationId, frameworkId])
}

model Control {
  id          String                  @id @default(cuid())
  frameworkId String
  code        String
  title       String
  description String?
  framework   Framework               @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  statuses    ControlImplementation[]
}

model ControlImplementation {
  id             String        @id @default(cuid())
  organizationId String
  controlId      String
  status         ControlStatus @default(not_started)
  ownerUserId    String?
  notes          String?
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control        Control       @relation(fields: [controlId], references: [id], onDelete: Cascade)
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  content        String
  status         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Risk {
  id              String       @id @default(cuid())
  organizationId  String
  title           String
  description     String
  impactScore     Int
  likelihoodScore Int
  severity        Int
  mitigation      String?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Evidence {
  id               String       @id @default(cuid())
  organizationId   String
  controlId        String
  fileName         String
  storageKey       String
  contentType      String
  uploadedByUserId String
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy       User         @relation("EvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
}

model Vendor {
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  serviceType         String
  riskLevel           String
  questionnaireStatus String
  complianceStatus    String
  riskScore           Int
  createdAt           DateTime     @default(now())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  target         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
